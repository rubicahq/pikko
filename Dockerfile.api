# syntax=docker/dockerfile:1
# Layer order: go.mod/sum first so dependency download stays cached across source edits.
# Runtime includes poppler-utils (pdftoppm) — required for catalog PDF page rasterization.
# Distroless cannot ship pdftoppm; without it the API silently used blank placeholder pages
# and Add Catalog under-detected / extracted nothing.
FROM golang:1.22-bookworm AS build
WORKDIR /src
COPY services/api/go.mod services/api/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY services/api/ ./
COPY database/ /database/
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -o /out/api ./cmd/api && \
    CGO_ENABLED=0 GOOS=linux go build -o /out/migrate ./cmd/migrate

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        poppler-utils \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 65532 nonroot \
    && useradd --system --uid 65532 --gid nonroot --home /app --shell /usr/sbin/nologin nonroot \
    && mkdir -p /app /data/storage \
    && chown -R nonroot:nonroot /app /data/storage
WORKDIR /app
COPY --from=build /out/api /app/api
COPY --from=build /out/migrate /app/migrate
COPY --from=build /database/migrations /database/migrations
ENV MIGRATIONS_PATH=file:///database/migrations
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/app/api"]
