# Application
APP_ENV=development
APP_BASE_DOMAIN=pikko.site
MARKETING_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
STOREFRONT_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
APP_DEFAULT_LOCALE=id-ID
APP_DEFAULT_TIMEZONE=Asia/Jakarta
APP_DEFAULT_CURRENCY=IDR

# Database
POSTGRES_USER=pikko
POSTGRES_PASSWORD=pikko
POSTGRES_DB=pikko
DATABASE_URL=postgres://pikko:pikko@localhost:5432/pikko?sslmode=disable

# Object storage (S3-compatible). Leave blank for local filesystem adapter.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=pikko
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_LOCAL_PATH=./.data/storage

# Email
EMAIL_PROVIDER=brevo
EMAIL_MODE=log
# EMAIL_MODE=log writes messages to stdout/logs (safe for local/dev).
# EMAIL_MODE=brevo sends via Brevo Transactional API (requires BREVO_API_KEY).
BREVO_API_KEY=
EMAIL_FROM_NAME=Pikko
EMAIL_ACCOUNT_FROM=account@pikko.site
EMAIL_NOTIFICATION_FROM=notifications@pikko.site
EMAIL_REPLY_TO=support@pikko.site

# Auth
AUTH_MAGIC_LINK_TTL_MINUTES=15
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_NAME=pikko_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Comma-separated redirect allowlist hosts (empty = APP_BASE_DOMAIN + localhost)
AUTH_REDIRECT_ALLOWLIST=localhost,127.0.0.1,pikko.site

# Rate limits (per window)
AUTH_RATE_LIMIT_EMAIL_PER_HOUR=5
AUTH_RATE_LIMIT_IP_PER_HOUR=20

# API
API_ADDR=:8080
API_CORS_ORIGINS=http://localhost:3000

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
