# Application
APP_ENV=development
APP_BASE_DOMAIN=pikko.site
# Prior apex during cutover (optional). Enables allowlist + app-level host redirect.
LEGACY_BASE_DOMAIN=
# APP_URL aliases MARKETING_URL when MARKETING_URL is unset
APP_URL=
MARKETING_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
STOREFRONT_URL=http://localhost:3000
HQ_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
# Shown in HQ System Health; set at deploy (git sha). Empty = unavailable (not fabricated).
DEPLOY_VERSION=
APP_DEFAULT_LOCALE=id-ID
APP_DEFAULT_TIMEZONE=Asia/Jakarta
APP_DEFAULT_CURRENCY=IDR

# Database
POSTGRES_USER=pikko
POSTGRES_PASSWORD=pikko
POSTGRES_DB=pikko
DATABASE_URL=postgres://pikko:pikko@localhost:5432/pikko?sslmode=disable

# Object storage (S3-compatible). Leave blank for local filesystem adapter.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=pikko
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_LOCAL_PATH=./.data/storage

# Email — From addresses default to account|notifications|support@APP_BASE_DOMAIN
EMAIL_PROVIDER=brevo
EMAIL_MODE=log
# EMAIL_MODE=log writes messages to stdout/logs (safe for local/dev).
# EMAIL_MODE=brevo sends via Brevo Transactional API (requires BREVO_API_KEY).
BREVO_API_KEY=
EMAIL_FROM_NAME=Pikko
EMAIL_ACCOUNT_FROM=account@pikko.site
EMAIL_NOTIFICATION_FROM=notifications@pikko.site
EMAIL_REPLY_TO=support@pikko.site

# AI gateway (OpenAI-compatible). Set values only in server .env — never commit secrets.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Auth
AUTH_MAGIC_LINK_TTL_MINUTES=15
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_NAME=pikko_session
PORTAL_COOKIE_NAME=pikko_portal_session
# Empty = host-only. On VPS set to the registrable domain (e.g. pikko.site) so
# marketing (pikko.site) and dashboard (app.pikko.site) share the session —
# nginx routes /api on both hosts straight to the Go API.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Comma-separated redirect allowlist hosts (default = localhost + APP_BASE_DOMAIN [+ LEGACY_BASE_DOMAIN])
AUTH_REDIRECT_ALLOWLIST=localhost,127.0.0.1,pikko.site

# Rate limits (per window)
AUTH_RATE_LIMIT_EMAIL_PER_HOUR=5
AUTH_RATE_LIMIT_IP_PER_HOUR=20
# Coarse API ceiling per client IP (public_rate_limits). Auth magic-link stays tighter.
API_RATE_LIMIT_IP_PER_HOUR=1200

# API
API_ADDR=:8080
API_CORS_ORIGINS=http://localhost:3000

# Backups (ops scripts under infrastructure/backup/)
BACKUP_DIR=~/backups/pikko
BACKUP_RETENTION_DAYS=14
BACKUP_POSTGRES_CONTAINER=pikko-postgres
BACKUP_STORAGE_VOLUME=pikko_api_storage
# Deploy-time dumps (scripts/deploy.sh) land under $BACKUP_DIR/deploy by default.

# Post-deploy smoke (scripts/smoke.sh) — domain-agnostic (E2E-N).
# Public checks use MARKETING_URL / DASHBOARD_URL / STOREFRONT_URL / API_BASE_URL
# unless SMOKE_PUBLIC_* overrides are set. Never auto-cutover to pikko.id.
# SMOKE_PUBLIC=0
# SMOKE_TIMEOUT_SEC=45
# SMOKE_READYZ=1
# SMOKE_API_URL=http://127.0.0.1:8100
# SMOKE_WEB_URL=http://127.0.0.1:3100
# SMOKE_PUBLIC_API_URL=
# SMOKE_PUBLIC_MARKETING_URL=
# SMOKE_PUBLIC_APP_URL=
# SMOKE_PUBLIC_SHOP_URL=

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_BASE_DOMAIN=pikko.site
NEXT_PUBLIC_LEGACY_BASE_DOMAIN=
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_HQ_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@pikko.site

# AI catalog import (SumoPod OpenAI-compatible). Leave AI_API_KEY empty for mock extractor (CI/local).
# Never commit real keys. Real AI is for manual testing only when key is present in env.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gemini/gemini-3.5-flash
IMPORT_MAX_PDF_BYTES=26214400
IMPORT_MAX_PAGES=50
IMPORT_MAX_ITEMS=500

# Feature flags (Agent 07). Store credit also requires per-store enablement.
FEATURE_STORE_CREDIT=false

# Subscriptions / entitlements (testing bypass ON; commercial trial OFF; real billing OFF).
FEATURE_SUBSCRIPTIONS=true
FEATURE_SUBSCRIPTION_PLAN_SELECT=true
FEATURE_SUBSCRIPTION_TEST_BYPASS=true
FEATURE_SUBSCRIPTION_USAGE_ENFORCE=true
FEATURE_SUBSCRIPTION_PLAN_CHANGE=true
FEATURE_COMMERCIAL_TRIAL=false
FEATURE_REAL_BILLING=false
FEATURE_SUBSCRIPTION_AUTO_RENEW=false
# Optional ops token for /api/v1/admin/subscription/*
# SUBSCRIPTION_ADMIN_TOKEN=
