# Production env template for official domain pikko.id (Phase 7).
# Copy values into ~/pikko/.env on the VPS — never commit real secrets.
# Do NOT flip production to these values until the owner explicitly approves cutover
# (DNS + TLS + Brevo sender auth ready). See docs/LAUNCH.md.

APP_ENV=production
APP_BASE_DOMAIN=pikko.id
LEGACY_BASE_DOMAIN=pikko.site
# APP_URL is an alias for MARKETING_URL
APP_URL=https://pikko.id
MARKETING_URL=https://pikko.id
DASHBOARD_URL=https://app.pikko.id
STOREFRONT_URL=https://shop.pikko.id
API_BASE_URL=https://api.pikko.id
APP_DEFAULT_LOCALE=id-ID
APP_DEFAULT_TIMEZONE=Asia/Jakarta
APP_DEFAULT_CURRENCY=IDR

POSTGRES_USER=pikko
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=pikko
# Host must be pikko-postgres (not "postgres") — see docs/DEPLOYMENT.md DNS clash note.
DATABASE_URL=postgres://pikko:CHANGE_ME_LONG_RANDOM@pikko-postgres:5432/pikko?sslmode=disable

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/storage
STORAGE_BUCKET=pikko

EMAIL_PROVIDER=brevo
EMAIL_MODE=brevo
BREVO_API_KEY=CHANGE_ME
EMAIL_FROM_NAME=Pikko
EMAIL_ACCOUNT_FROM=account@pikko.id
EMAIL_NOTIFICATION_FROM=notifications@pikko.id
EMAIL_REPLY_TO=support@pikko.id

AUTH_MAGIC_LINK_TTL_MINUTES=15
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_NAME=pikko_session
# Leave empty while Next.js proxies /api on the same host (host-only cookie).
# Set to .pikko.id only if cookies must be shared across subdomains deliberately.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_REDIRECT_ALLOWLIST=localhost,127.0.0.1,pikko.id,pikko.site
AUTH_RATE_LIMIT_EMAIL_PER_HOUR=5
AUTH_RATE_LIMIT_IP_PER_HOUR=20
API_RATE_LIMIT_IP_PER_HOUR=1200

API_ADDR=:8080
API_CORS_ORIGINS=https://app.pikko.id,https://pikko.id,https://shop.pikko.id

# Web build-time public URLs (docker compose build args)
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_BASE_DOMAIN=pikko.id
NEXT_PUBLIC_LEGACY_BASE_DOMAIN=pikko.site
NEXT_PUBLIC_MARKETING_URL=https://pikko.id
NEXT_PUBLIC_DASHBOARD_URL=https://app.pikko.id
NEXT_PUBLIC_STOREFRONT_URL=https://shop.pikko.id
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=support@pikko.id

# AI (SumoPod) — rotate before launch; never commit real keys
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gemini/gemini-3.5-flash
IMPORT_MAX_PDF_BYTES=26214400
IMPORT_MAX_PAGES=50
IMPORT_MAX_ITEMS=500
