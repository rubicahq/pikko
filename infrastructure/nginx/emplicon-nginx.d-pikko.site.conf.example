# Production vhost for Emplicon nginx (emplicon-nginx).
# Installed on the VPS as: ~/emplicon/deploy/nginx.d/pikko.site.conf
#
# Prerequisites:
#   1) Cloudflare DNS A records (DNS-only until HTTPS verified) for
#      pikko.site, app.pikko.site, shop.pikko.site, api.pikko.site, hq.pikko.site → VPS IP
#   2) Let's Encrypt cert (include hq.pikko.site SAN) copied to
#      ~/emplicon/deploy/ssl/pikko/{fullchain,privkey}.pem
#   3) pikko-web + pikko-api attached to network emplicon_emplicon
#
# Attach (additive; does not restart Emplicon):
#   sudo docker network connect emplicon_emplicon pikko-web
#   sudo docker network connect emplicon_emplicon pikko-api
#
# Apply:
#   sudo docker exec emplicon-nginx nginx -t && sudo docker exec emplicon-nginx nginx -s reload

# HTTP → HTTPS (ACME challenge stays on :80)
server {
    listen 80;
    server_name pikko.site app.pikko.site shop.pikko.site api.pikko.site hq.pikko.site;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name pikko.site app.pikko.site shop.pikko.site hq.pikko.site;
    ssl_certificate     /etc/nginx/ssl/pikko/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/pikko/privkey.pem;
    client_max_body_size 20m;
    # Edge hardening (apps also set headers; keep edge conservative)
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    set $pikko_web "pikko-web:3000";
    set $pikko_api "pikko-api:8080";

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type "text/plain";
    }

    location ^~ /api/ {
        proxy_pass http://$pikko_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location = /healthz {
        proxy_pass http://$pikko_api/healthz;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://$pikko_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache_bypass $http_upgrade;
        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

server {
    listen 443 ssl;
    server_name api.pikko.site;
    ssl_certificate     /etc/nginx/ssl/pikko/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/pikko/privkey.pem;
    client_max_body_size 20m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    set $pikko_api "pikko-api:8080";

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type "text/plain";
    }

    location / {
        proxy_pass http://$pikko_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
