# Example server blocks for the existing Emplicon nginx (emplicon-nginx).
# DO NOT install until:
#   1) Cloudflare DNS A/AAAA for pikko.site + app./shop./api. point at this VPS
#   2) TLS certs exist under deploy/ssl/pikko/ (or Cloudflare origin cert covers pikko.site)
#   3) pikko-web and pikko-api are attached to network emplicon_emplicon
#
# Attach (additive; does not restart Emplicon):
#   sudo docker network connect emplicon_emplicon pikko-web
#   sudo docker network connect emplicon_emplicon pikko-api
#
# Then copy this file to ~/emplicon/deploy/nginx.d/pikko.site.conf and:
#   sudo docker exec emplicon-nginx nginx -t && sudo docker exec emplicon-nginx nginx -s reload

server {
    listen 80;
    server_name pikko.site www.pikko.site app.pikko.site shop.pikko.site;
    client_max_body_size 20m;
    set $pikko_web "pikko-web:3000";
    set $pikko_api "pikko-api:8080";

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type "text/plain";
    }

    location ^~ /api/ {
        proxy_pass http://$pikko_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /healthz {
        proxy_pass http://$pikko_api/healthz;
    }

    location / {
        proxy_pass http://$pikko_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

server {
    listen 80;
    server_name api.pikko.site;
    client_max_body_size 20m;
    set $pikko_api "pikko-api:8080";

    location / {
        proxy_pass http://$pikko_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# TLS blocks (uncomment after certs exist):
# server {
#     listen 443 ssl;
#     server_name pikko.site www.pikko.site app.pikko.site shop.pikko.site;
#     ssl_certificate     /etc/nginx/ssl/pikko/fullchain.pem;
#     ssl_certificate_key /etc/nginx/ssl/pikko/privkey.pem;
#     ... same locations as HTTP, X-Forwarded-Proto https ...
# }
